# ==== API KEYS (jangan commit file .env asli) ====
GMGN_API_KEY=
ETHERSCAN_API_KEY=
GOPLUS_API_KEY=
COINGECKO_API_KEY=

# ==== SUPABASE ====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ==== SCAN SETTINGS ====
# -- Liquidity floor
MIN_LIQUIDITY_ACCUMULATION=5000
MIN_LIQUIDITY_DEADWHALE=1000

# -- Age / concentration / tax
MIN_AGE_DAYS=4
MAX_TOP10_PCT=65.0
MAX_TAX_PCT=10.0
MIN_FEE_MC_RATIO=1e-5

# -- Wash trading penalty thresholds
WASH_VOLUME_RATIO=3.0
DEXS_MIN_AVG_TRADE=50
DEXS_MAX_TX_PER_HOUR=10

# -- Wet per scan: berapa token yang di-fetch (rate-limit friendly)
SCAN_LIMIT=50

# -- Sinyal minimum (penyimpanan), default kiwi: hanya simpan yang lolos
MIN_ALPHA_TO_SAVE=40

# == MODE STEERING ==
CHAIN_WEIGHT_ORDER=base,eth,sol,bsc,robinhood
ENABLE_MODE_ACCUMULATION=true
ENABLE_MODE_DEADWHALE=true

# === OPTIONAL: notifikasi Discord ===
DISCORD_WEBHOOK_URL=