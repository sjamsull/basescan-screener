# ==== API KEYS (jangan commit file .env asli) ====
GMGN_API_KEY=
ETHERSCAN_API_KEY=
GOPLUS_API_KEY=
COINGECKO_API_KEY=
BLOCKSCOUT_API_KEY=

# ==== SUPABASE ====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ==== SCAN SETTINGS ====
# -- Liquidity floor
MIN_LIQUIDITY_ACCUMULATION=5000
MIN_LIQUIDITY_DEADWHALE=1000

# -- Age / concentration / tax
MIN_AGE_DAYS=4
MAX_TOP10_PCT=65.0
MAX_TAX_PCT=10.0
MIN_FEE_MC_RATIO=1e-5

# -- Wash trading penalty thresholds
WASH_VOLUME_RATIO=3.0
DEXS_MIN_AVG_TRADE=50
DEXS_MAX_TX_PER_HOUR=10

# -- Wet per scan: berapa token yang di-fetch (rate-limit friendly)
SCAN_LIMIT=50

# -- Sinyal minimum (penyimpanan), default kiwi: hanya simpan yang lolos
MIN_ALPHA_TO_SAVE=40

# == MODE STEERING ==
CHAIN_WEIGHT_ORDER=base,eth,sol,bsc,robinhood
ENABLE_MODE_ACCUMULATION=true
ENABLE_MODE_DEADWHALE=true

# === OPTIONAL: notifikasi Discord ===
DISCORD_WEBHOOK_URL=

# === DEAD-WHALE DETECTION (DW_*) ===
DW_WHALE_BALANCE_USD=10000
DW_MIN_BUY_USD=100
DW_MIN_TOKEN_AGE_DAYS=30
DW_MAX_PRICE_RISE_12H=10
DW_MAX_PRICE_RISE_36H=20
DW_MAX_VOLUME_MULTIPLIER=3
DW_CONFIRMATION_WINDOW_H=18
DW_LOOKBACK_DAYS=30
DW_HOLD_MIN_DAYS=3
DW_DEAD_TXNS_THRESHOLD=5
DW_DEAD_VOLUME_USD=1000
DW_UNIVERSE_PAGES=8
DW_SCAN_LIMIT=50

# === DEAD-WHALE universe (Dune, opsional) ===
# Buat query SQL 'base token list' di Dune UI (network=Base), dapat query_id dari URL.
DUNE_API_KEY=
DUNE_DEAD_TOKENS_QUERY_ID=